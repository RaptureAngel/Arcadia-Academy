{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for Arcadia Academy.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:allow-open",
    "fs:default",
    "fs:create-app-specific-dirs",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/*" },
        { "path": "$APPDATA/**/*" }
      ]
    }
  ]
}
